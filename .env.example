# =============================================================================
# Industrial Corporate Portfolio Platform — Environment Variables
# =============================================================================
#
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# NEVER commit `.env` to version control.
# All variables are validated at application startup via Zod (src/lib/env.ts).
#
# Required variables must be set before the app will start in production.
# Optional variables have safe defaults or disable features when unset.
#
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────

# Runtime environment. Use "development" locally, "production" on servers.
NODE_ENV=development

# Public-facing site URL (no trailing slash). Used for canonical URLs, sitemap,
# Open Graph links, and email templates.
# Example: https://www.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Port the Next.js server listens on (Docker / VPS deployments).
PORT=3000

# ─── Database ────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Local (Docker Compose): postgresql://postgres:postgres@localhost:5432/industrial_platform
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/industrial_platform

# ─── Payload CMS ─────────────────────────────────────────────────────────────

# Secret key for encrypting Payload sessions and tokens.
# Generate: openssl rand -hex 32
# REQUIRED in production. Must be at least 32 characters.
PAYLOAD_SECRET=change-me-to-a-random-64-character-string-in-production

# URL path for the Payload admin panel.
# Default: /admin
PAYLOAD_ADMIN_ROUTE=/admin

# ─── Storage ─────────────────────────────────────────────────────────────────

# Active storage provider: local | cloudinary | s3
# - local:      Files saved to MEDIA_ROOT (best for VPS / local dev)
# - cloudinary: Cloud-hosted with image transformations (REQUIRED on Vercel)
# - s3:         AWS S3 or S3-compatible (R2, MinIO)
#
# On Vercel you MUST use cloudinary or s3 — local disk is ephemeral/read-only.
STORAGE_PROVIDER=local

# --- Local storage (when STORAGE_PROVIDER=local) ---

# Directory for uploaded media files, relative to project root.
MEDIA_ROOT=./media

# --- Cloudinary (when STORAGE_PROVIDER=cloudinary) ---

# Cloudinary cloud name from your dashboard.
CLOUDINARY_CLOUD_NAME=

# Cloudinary API key.
CLOUDINARY_API_KEY=

# Cloudinary API secret.
CLOUDINARY_API_SECRET=

# --- AWS S3 (when STORAGE_PROVIDER=s3) ---

# S3 bucket name.
S3_BUCKET=

# AWS region (e.g. ap-south-1 for Mumbai).
S3_REGION=

# AWS access key ID.
S3_ACCESS_KEY_ID=

# AWS secret access key.
S3_SECRET_ACCESS_KEY=

# Optional custom endpoint for S3-compatible services (Cloudflare R2, MinIO).
# Example: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=

# ─── Email ───────────────────────────────────────────────────────────────────

# Email provider: resend | smtp
# - resend: Uses Resend API (recommended for simplicity)
# - smtp:   Uses SMTP credentials (e.g. Hostinger mail)
EMAIL_PROVIDER=resend

# Default "from" address for transactional emails.
EMAIL_FROM=noreply@example.com

# Recipient for form submission notifications (sales team inbox).
# Comma-separated for multiple recipients.
EMAIL_TO_SALES=sales@example.com

# --- Resend (when EMAIL_PROVIDER=resend) ---

# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=

# --- SMTP (when EMAIL_PROVIDER=smtp) ---

# SMTP server hostname.
SMTP_HOST=

# SMTP port (587 for TLS, 465 for SSL).
SMTP_PORT=587

# SMTP username.
SMTP_USER=

# SMTP password.
SMTP_PASS=

# ─── Security ────────────────────────────────────────────────────────────────

# Cloudflare Turnstile site key (public, exposed to browser).
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile secret key (server-side only).
TURNSTILE_SECRET_KEY=

# Secret for on-demand ISR revalidation webhook (/api/revalidate).
# Generate: openssl rand -hex 32
REVALIDATE_SECRET=

# Rate limiting: maximum requests per IP per window (API routes + forms).
RATE_LIMIT_MAX=10

# Rate limiting window in milliseconds (default: 60000 = 1 minute).
RATE_LIMIT_WINDOW_MS=60000

# ─── Search ──────────────────────────────────────────────────────────────────

# Search provider: postgres | meilisearch | algolia
# V1 uses postgres (PostgreSQL full-text search).
SEARCH_PROVIDER=postgres

# --- Meilisearch (future, when SEARCH_PROVIDER=meilisearch) ---

MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# --- Algolia (future, when SEARCH_PROVIDER=algolia) ---

ALGOLIA_APP_ID=
ALGOLIA_API_KEY=
ALGOLIA_INDEX_NAME=

# ─── Analytics ─────────────────────────────────────────────────────────────────

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Loaded only after cookie consent is accepted.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─── Feature Flags ─────────────────────────────────────────────────────────────

# Enable Payload GraphQL API (disabled by default for security).
ENABLE_GRAPHQL=false

# ─── CI / Testing (optional) ───────────────────────────────────────────────────

# Base URL for Playwright E2E tests (defaults to NEXT_PUBLIC_SITE_URL).
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Set to "true" in CI to skip interactive Playwright prompts.
CI=false
